#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 python3
systemctl enable --now docker
mkdir -p /opt/ss2-airflow-dbt
cd /opt/ss2-airflow-dbt
python3 - <<'PY'
import base64, io, json, os, pathlib, shutil, urllib.parse, urllib.request, zipfile
root = pathlib.Path('/opt/ss2-airflow-dbt')
req = urllib.request.Request('http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token', headers={'Metadata-Flavor':'Google'})
with urllib.request.urlopen(req) as response:
    access_token = json.load(response)['access_token']
def fetch(url):
    req = urllib.request.Request(url, headers={'Authorization':'Bearer '+access_token})
    with urllib.request.urlopen(req, timeout=90) as response:
        return response.read()
url = 'https://storage.googleapis.com/storage/v1/b/${bucket}/o/' + urllib.parse.quote('${object}', safe='') + '?alt=media'
with zipfile.ZipFile(io.BytesIO(fetch(url))) as archive:
    archive.extractall(root)
secret = json.loads(base64.b64decode(json.loads(fetch('https://secretmanager.googleapis.com/v1/projects/${project}/secrets/${secret}/versions/latest:access'))['payload']['data']))
for name in ['auth','logs','live/releases/bootstrap']:
    (root/name).mkdir(parents=True, exist_ok=True)
    os.chown(root/name, 50000, 0)
    os.chmod(root/name, 0o775)
for name in ['dags','dbt']:
    shutil.copytree(root/name, root/'live/releases/bootstrap'/name, dirs_exist_ok=True)
if not (root/'live/current').exists():
    (root/'live/current').symlink_to('releases/bootstrap', target_is_directory=True)
auth = root/'auth/passwords.json'
auth.write_text(json.dumps({'admin':secret['admin'],'estudiantes':secret['viewer']}))
os.chown(auth, 50000, 0)
os.chmod(auth, 0o640)
env = {
    'AIRFLOW_HOST':'${host}', 'METADATA_PASSWORD':secret['metadata'],
    'DBT_PASSWORD':secret['warehouse'], 'AIRFLOW__CORE__FERNET_KEY':secret['fernet'],
    'AIRFLOW__API_AUTH__JWT_SECRET':secret['jwt'], 'AIRFLOW__API__SECRET_KEY':secret['api'],
    'AIRFLOW_CONN_WAREHOUSE_SGFOOD': json.dumps({'conn_type':'postgres','host':'warehouse','login':'sgfood','password':secret['warehouse'],'schema':'sgfood_dw','port':5432})
}
envfile = root/'runtime/.env'
envfile.write_text('\n'.join(k+'='+v for k,v in env.items())+'\n')
os.chmod(envfile, 0o600)
(root/'runtime/platform.json').write_text(json.dumps({'bucket':'${bucket}'}))
PY
cat >/etc/systemd/system/ss2-airflow-dbt-sync.service <<'EOF'
[Unit]
Description=Actualizar DAGs y dbt desde GitHub via GCS
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/ss2-airflow-dbt/scripts/runtime/sync_release.py
EOF
cat >/etc/systemd/system/ss2-airflow-dbt-sync.timer <<'EOF'
[Unit]
Description=Comprobar nuevas entregas cada minuto
[Timer]
OnBootSec=30
OnUnitActiveSec=60
[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now ss2-airflow-dbt-sync.timer
docker compose --env-file runtime/.env -f runtime/docker-compose.yml up -d --build
echo 'SS2_AIRFLOW_DBT_STARTUP_COMPLETE'
