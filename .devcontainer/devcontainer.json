{
  "name": "SS2 - Airflow y dbt",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {"cpus": 2, "memory": "8gb", "storage": "20gb"},
  "features": {"ghcr.io/devcontainers/features/github-cli:1": {}},
  "postCreateCommand": "bash scripts/setup_codespace.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "redhat.vscode-yaml"],
      "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}
    }
  },
  "remoteUser": "vscode"
}
